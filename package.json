{
  "name": "life-rpg-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @liferpg/web dev",
    "dev:api": "pnpm --filter @liferpg/api dev",
    "dev": "pnpm --parallel --filter @liferpg/api --filter @liferpg/web dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
